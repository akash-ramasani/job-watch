rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Metadata Rules
    // Allows users to read/write only their own profile information
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // The admin manages every account. A person creates their own record
      // only with an invite they just used (Signup.jsx), and with AI off.
      allow create: if isAdmin() || (isOwner(userId) && createWithInvite());
      // A person edits their own profile, but not the fields the admin
      // controls: AI access (spends the admin's AI budget), account type and
      // trial dates. They may only deactivate themselves (trial end, App.jsx).
      allow update: if isAdmin() || (isOwner(userId) && ownerUpdateOk());
      allow delete: if isAdmin() || isOwner(userId);
      
      // Public read for the admin's mapClusters aggregation only — used by the
      // landing-page hero map (shown to signed-out visitors). Contains only
      // aggregated city/lat/lng/count data.
      match /aggregations/mapClusters {
        allow read: if userId == "7Tojjo8l5PZIYctPmdwncf7PC133";
      }

      // 2. Owner access to all of their own subcollections (recursive).
      // This is the ONLY rule that exposes personal collections such as
      // sessions, sessionHistory, settings, and resume — restricted to the
      // owner so session tokens, IPs, and resume data never leak cross-user.
      match /{subcollection}/{rest=**} { // at least one segment: {x=**} alone also matched users/{uid} itself
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 3. Shared job corpus (admin-owned, read-only to any signed-in user).
      // Explicitly enumerated instead of a wildcard so that adding a new
      // subcollection later can't accidentally expose it. Writes stay
      // owner-only via the recursive rule above.
      match /jobs/{jobId} {
        allow read: if request.auth != null && userId == "7Tojjo8l5PZIYctPmdwncf7PC133";
      }
      // Feeds, companies and sync history are admin-only: the owner rule above
      // already covers the admin, so no extra read rule for anyone else.
      // Only the shared job-list rollups. The admin's own myJobScores and
      // scoringStatus are personal and stay owner-only like every user's.
      match /aggregations/{aggId} {
        allow read: if request.auth != null && userId == "7Tojjo8l5PZIYctPmdwncf7PC133"
          && aggId in ["recentJobs", "allJobs", "companyStats", "mapClusters"];
      }
    }

    // 3. Collection Group Rules for "jobs"
    // Allows Jobs.jsx to fetch jobs globally if the data matches the admin or the user
    match /{path=**}/jobs/{jobId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || resource.data.uid == "7Tojjo8l5PZIYctPmdwncf7PC133");
      // Write is handled by Cloud Functions or user-specific rules
    }
    
    // Nothing writes here any more (the landing form is gone); it was open to
    // anyone, unauthenticated, with no limits.
    match /interestedUsers/{docId} {
      allow create: if false;
      allow read: if request.auth != null && (request.auth.uid == "7Tojjo8l5PZIYctPmdwncf7PC133");
    }

    // Invite codes are unguessable 8-char bearer tokens. Anyone holding the
    // code can fetch the invite by ID (needed during /signup before the user
    // has authenticated). Listing the collection is admin-only so we don't
    // leak the full set of outstanding codes. Writes are restricted:
    //   - create: admin only
    //   - update: only to mark `used: true` on an unused, unexpired invite
    //   - delete: admin only
    // This makes the TTL and single-use guarantees enforceable server-side.
    match /invites/{inviteId} {
      allow get: if true;
      allow list: if request.auth != null
        && request.auth.uid == "7Tojjo8l5PZIYctPmdwncf7PC133";
      allow create, delete: if request.auth != null
        && request.auth.uid == "7Tojjo8l5PZIYctPmdwncf7PC133";
      allow update: if request.auth != null
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && (resource.data.expiresAt == null || resource.data.expiresAt > request.time);
    }

    
    function isAdmin() {
      return request.auth != null && request.auth.uid == "7Tojjo8l5PZIYctPmdwncf7PC133";
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Admin-controlled fields on users/{uid}.
    function guardedKeys() {
      return ['aiAccess', 'accountStatus', 'accountType', 'trialEndsAt', 'trialDays', 'inviteCode'];
    }
    function createWithInvite() {
      let d = request.resource.data;
      let invite = get(/databases/$(database)/documents/invites/$(d.inviteCode)).data;
      return d.inviteCode is string
        && invite.usedBy == request.auth.uid
        && d.get('aiAccess', false) == false
        && d.get('accountType', 'trial') == invite.get('accountType', 'trial')
        && d.get('accountStatus', 'trial') in ['trial', 'active'];
    }
    function ownerUpdateOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(guardedKeys())
        || (changed.hasOnly(['accountStatus', 'aiAccess'])
            && request.resource.data.accountStatus == 'deactivated'
            && request.resource.data.get('aiAccess', false) == false);
    }

    // Helper function to extract UID from path if needed
    function userIdFromPath(path) {
      return path[1]; // Returns 'uid' from /users/{uid}/...
    }
  }
}