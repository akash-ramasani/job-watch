{
  "manifest_version": 3,
  "name": "JobWatch Auto Apply",
  "version": "1.11.34",
  "description": "Apply to jobs from JobWatch: auto-apply on Ashby, Greenhouse and Lever with a tailored resume, and Autofill on Lever, Workday and every other job board.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "identity",
    "alarms",
    "notifications",
    "power"
  ],
  "host_permissions": [
    "*://*/*",
    "https://firestore.googleapis.com/*",
    "https://firebasestorage.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://us-central1-greenhouse-jobs-scrapper.cloudfunctions.net/*",
    "https://*.chromiumapp.org/*",
    "https://gmail.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://greenhouse-jobs-scrapper.web.app/*",
        "https://jobwatch.akashramasani.com/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "content/jobwatch-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://greenhouse-jobs-scrapper.web.app/*",
        "https://jobwatch.akashramasani.com/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "content/jobwatch-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://jobs.ashbyhq.com/*"
      ],
      "js": [
        "content/ashby-net.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://jobs.ashbyhq.com/*/application*"
      ],
      "js": [
        "content/wake.js",
        "content/highlight.js",
        "content/notify.js",
        "lib/rescue-dom.js",
        "content/rescue.js",
        "content/submit-flow.js",
        "content/ashby.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/embed/job_app*",
        "https://job-boards.greenhouse.io/embed/job_app*",
        "https://job-boards.greenhouse.io/*/jobs/*",
        "https://boards.greenhouse.io/*/jobs/*"
      ],
      "all_frames": true,
      "js": [
        "content/wake.js",
        "content/highlight.js",
        "content/notify.js",
        "lib/rescue-dom.js",
        "content/rescue.js",
        "content/submit-flow.js",
        "content/greenhouse.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jobs.lever.co/*/*/apply*",
        "https://jobs.eu.lever.co/*/*/apply*"
      ],
      "js": [
        "content/wake.js",
        "content/highlight.js",
        "content/notify.js",
        "lib/rescue-dom.js",
        "content/rescue.js",
        "content/submit-flow.js",
        "content/lever.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.icims.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/*",
        "https://*.successfactors.eu/*",
        "https://*.sapsf.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.workable.com/*",
        "https://*.bamboohr.com/*",
        "https://*.jobvite.com/*",
        "https://*.oraclecloud.com/*",
        "https://*.eightfold.ai/*",
        "https://*.applytojob.com/*",
        "https://*.breezy.hr/*",
        "https://recruiting.paylocity.com/*",
        "https://*.ultipro.com/*",
        "https://*.ukg.net/*",
        "https://workforcenow.adp.com/*",
        "https://myjobs.adp.com/*",
        "https://*.paycomonline.net/*",
        "https://*.pageuppeople.com/*",
        "https://*.csod.com/*",
        "https://*.avature.net/*",
        "https://*.brassring.com/*",
        "https://jobs.silkroad.com/*",
        "https://*.applicantpro.com/*",
        "https://apply.interfolio.com/*",
        "https://*.peopleadmin.com/*",
        "https://www.governmentjobs.com/*",
        "https://www.schooljobs.com/*",
        "https://ats.rippling.com/*",
        "https://*.recruitee.com/*",
        "https://*.teamtailor.com/*",
        "https://*.jobs.personio.com/*",
        "https://*.jobs.personio.de/*",
        "https://app.dover.com/*",
        "https://*.pinpointhq.com/*",
        "https://*.freshteam.com/*",
        "https://*.zohorecruit.com/*"
      ],
      "all_frames": true,
      "js": [
        "content/wake.js",
        "content/highlight.js",
        "content/notify.js",
        "lib/rescue-dom.js",
        "content/rescue.js",
        "content/universal.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "JobWatch Auto Apply",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
